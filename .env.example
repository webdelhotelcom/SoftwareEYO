# Software EYO — variables de entorno de referencia
#
# app/panel.html es un HTML estático sin proceso de build (no hay Node, no
# hay bundler), así que en realidad NO lee este archivo .env — un navegador
# no puede leer archivos .env del disco. Lo que sí usa el panel es
# app/config.js (ver app/config.example.js), que define las mismas dos
# variables como globals de JavaScript. Este .env.example es la referencia
# documentada de qué valores hacen falta, en el formato estándar.
#
# Ninguno de los dos archivos (.env ni config.js) se sube a git — están en
# .gitignore a propósito.

# Project URL de tu proyecto de Supabase.
# Dónde conseguirlo: Supabase Dashboard → tu proyecto → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Clave "anon public" del mismo lugar. Es segura de exponer en el navegador:
# la protección real de los datos la da Row Level Security en la base de
# datos (ver supabase/migrations/), no el secreto de esta clave.
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# NUNCA pongas acá la clave "service_role". Esa es secreta: quien la tenga
# puede saltarse todas las políticas RLS y ver los datos de todos los
# clientes. No debe estar en este repositorio, en el HTML ni llegar al
# navegador bajo ninguna circunstancia.
